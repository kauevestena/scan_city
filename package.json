{
  "name": "scan-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Scan City — simulador RPG de fotogrametria e LiDAR",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:firefox": "playwright test -c playwright.firefox.config.ts",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:terms": "node scripts/check-forbidden-terms.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "qa:random": "node scripts/qa-random.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run check:placeholders && npm run check:terms"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-canvas-mock": "^1.2.0"
  }
}
